# Normalize line endings. Store text as LF in the repo; check out with native EOL.
* text=auto

# Windows-only scripts should keep CRLF on checkout.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Unix shell scripts must retain LF so their shebang works on Linux.
*.sh text eol=lf

# Treat known binary assets as binary.
*.ico binary
*.png binary
*.jpg binary
