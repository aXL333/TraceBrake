<Window x:Class="Foreman.App.Windows.UniversalTrustSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Universal Trust Settings" Width="780" Height="800"
        MinWidth="680" MinHeight="620" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
        </Style>
        <Style x:Key="CapabilityLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CapabilityCombo" TargetType="ComboBox">
            <Setter Property="MinWidth" Value="245" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <SolidColorBrush x:Key="ObservationAccentBrush" Color="#FF66B6E8" />
        <SolidColorBrush x:Key="ObservationPanelBrush" Color="#FF101C27" />
        <SolidColorBrush x:Key="ObservationBorderBrush" Color="#FF285777" />
        <SolidColorBrush x:Key="ControlPanelBrush" Color="#FF211A10" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF725223" />
        <LinearGradientBrush x:Key="TrustIntroBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF181F29" Offset="0" />
            <GradientStop Color="#FF241B0D" Offset="1" />
        </LinearGradientBrush>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource AccentBrush}" CornerRadius="3" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="Universal Trust Settings" FontSize="21" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" FontFamily="Segoe UI, Arial" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,5,0,0"
                           Text="Each harness inherits one of these shared profiles from its Trust level. Observation covers reading or capture; control covers actions that change a browser, the Windows desktop, or an Android device." />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" CornerRadius="7" Padding="12" Margin="0,0,0,12"
                Background="{StaticResource TrustIntroBrush}" BorderBrush="#FF5D4820" BorderThickness="1">
            <TextBlock Style="{StaticResource Muted}">
                <Run Text="Never" FontWeight="SemiBold" Foreground="{StaticResource SeverityCritical}" />
                <Run Text=" removes the privilege. " />
                <Run Text="Ask every time" FontWeight="SemiBold" Foreground="{StaticResource SeverityMedium}" />
                <Run Text=" holds each request for you. " />
                <Run Text="Unattended while unlocked" FontWeight="SemiBold" Foreground="{StaticResource ObservationAccentBrush}" />
                <Run Text=" stops unattended delivery when Windows is locked. " />
                <Run Text="Unattended, including while locked" FontWeight="SemiBold" Foreground="{StaticResource SeverityHigh}" />
                <Run Text=" grants standing authority. Per-harness ceilings can still make an individual harness stricter." />
            </TextBlock>
        </Border>

        <Border Grid.Row="2" CornerRadius="7" Padding="11" Margin="0,0,0,12"
                Background="#FF171A22" BorderBrush="#FF3B414F" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="EDIT PROFILE" Margin="0,0,12,0" VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11" FontFamily="Segoe UI, Arial" />
                <ComboBox x:Name="TrustLevelCombo" Grid.Column="1" MinWidth="280" HorizontalAlignment="Left"
                          SelectionChanged="TrustLevelSelectionChanged" />
                <Button Grid.Column="2" Content="Reset this profile" Click="ResetCurrentClick" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border CornerRadius="8" Padding="14" Margin="0,0,0,12"
                        Background="{StaticResource ObservationPanelBrush}" BorderBrush="{StaticResource ObservationBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Right" Background="#332F94C5" BorderBrush="{StaticResource ObservationBorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="7,2">
                                <TextBlock Text="READ / CAPTURE" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource ObservationAccentBrush}" />
                            </Border>
                            <TextBlock Text="Observation privileges" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource ObservationAccentBrush}" FontFamily="Segoe UI, Arial" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,12"
                                   Text="Read-only inspection, screenshots, tab/device inventory and Android UI/log capture." />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="155" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Browser observation" Style="{StaticResource CapabilityLabel}" />
                            <ComboBox x:Name="BrowserObservationCombo" Grid.Row="0" Grid.Column="1" Margin="0,0,0,9" Style="{StaticResource CapabilityCombo}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Desktop observation" Style="{StaticResource CapabilityLabel}" />
                            <ComboBox x:Name="DesktopObservationCombo" Grid.Row="1" Grid.Column="1" Margin="0,0,0,9" Style="{StaticResource CapabilityCombo}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="ADB observation" Style="{StaticResource CapabilityLabel}" />
                            <ComboBox x:Name="AdbObservationCombo" Grid.Row="2" Grid.Column="1" Style="{StaticResource CapabilityCombo}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border CornerRadius="8" Padding="14"
                        Background="{StaticResource ControlPanelBrush}" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Right" Background="#334D3410" BorderBrush="{StaticResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="7,2">
                                <TextBlock Text="CHANGES STATE" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <TextBlock Text="Control privileges" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" FontFamily="Segoe UI, Arial" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,12"
                                   Text="Navigation, typing and clicking; desktop input; and Android tap, type, swipe, key or APK installation." />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="155" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Browser control" Style="{StaticResource CapabilityLabel}" />
                            <ComboBox x:Name="BrowserControlCombo" Grid.Row="0" Grid.Column="1" Margin="0,0,0,9" Style="{StaticResource CapabilityCombo}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Desktop control" Style="{StaticResource CapabilityLabel}" />
                            <ComboBox x:Name="DesktopControlCombo" Grid.Row="1" Grid.Column="1" Margin="0,0,0,9" Style="{StaticResource CapabilityCombo}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="ADB broker use" Style="{StaticResource CapabilityLabel}" />
                            <ComboBox x:Name="AdbControlCombo" Grid.Row="2" Grid.Column="1" Style="{StaticResource CapabilityCombo}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Button Content="Reset all Trust profiles to defaults" Click="ResetAllClick"
                        HorizontalAlignment="Left" Margin="0,12,0,0"
                        Foreground="{StaticResource SeverityMedium}" BorderBrush="{StaticResource ControlBorderBrush}" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" HorizontalAlignment="Left"
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" FontFamily="Segoe UI, Arial" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="CancelClick" Margin="0,0,8,0" />
                <Button Content="Save universal settings" Click="SaveClick" Padding="18,6"
                        Background="{StaticResource AccentBrush}" Foreground="#FF0D0F12" FontWeight="Bold" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
