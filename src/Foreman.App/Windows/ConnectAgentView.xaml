<UserControl x:Class="Foreman.App.Windows.ConnectAgentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
        </Style>
        <Style x:Key="Mono" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontFamily" Value="Consolas, monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Connect an agent to TraceBrake" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI, Arial" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                       Text="TraceBrake runs a local MCP server your AI agent connects to. That connection is how TraceBrake reports status to the agent, how the agent can pre-flight a command, and how 'Ask Harness' reaches it. Pick your agent below, then restart it." />
            <!-- Connected list lives in the fixed header, so cap it with its own scroll: a flood of entries
                 must never inflate the header and push the agent cards (Row 1) off-screen. -->
            <Border Margin="0,10,0,0" CornerRadius="6" Padding="10,7"
                    Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ConnectedText" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI, Arial" />
                </ScrollViewer>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Connect all agents" Click="ConnectAllClick"
                        Background="{StaticResource AccentBrush}" Foreground="#FF0D0F12" FontWeight="Bold" />
                <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="540"
                           Text="Re-deploys a fresh per-agent scoped &quot;foreman&quot; key (MCP token) into the config of each agent that's running, configured, or installed: Claude Code, Codex, Cursor, OpenCode, Copilot, Gemini, LM Studio, T3. Connects new agents and repairs stale keys in one pass; the confirmation names exactly which were written. Restart each agent afterward." />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- TraceBrake browser extension + shared computer-use driver. Hoisted to the top: the driver gate is the
                     primary broker control, so it sits directly under "Connect all agents" instead of last. -->
                <Border CornerRadius="8" Padding="14" Margin="0,0,0,12"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🔒 Unified computer-use broker (on-device)" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10"
                                   Text="The same audited cu_* plugin routes approved harnesses to browser use and the optional Android/ADB bridge. Browser execution uses the paired extension below; Android executes locally in TraceBrake. Click Pair, then enter the shown code in the extension's Options within 2 minutes." />
                        <Button Content="Pair…" Click="PairExtensionClick" HorizontalAlignment="Left"
                                Background="{StaticResource AccentBrush}" Foreground="#FF0D0F12" FontWeight="Bold" />

                        <Border Background="#FF15181D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="10" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Computer-use driver(s)" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,7"
                                           Text="Tick which harness(es) may submit browser and Android/ADB (cu_*) actions through TraceBrake's unified plugin. None = operator only; 'any' = every connected harness. Per-harness Browser use / Computer use policies still apply. Actions remain audited, approval-gated when risky, and panic-haltable." />
                                <ItemsControl x:Name="CuDriverList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,16,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Set drivers" Click="SetCuDriverClick" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                <TextBlock x:Name="CuDriverStatus" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Claude Code -->
                <Border CornerRadius="8" Padding="14" Margin="0,0,0,12"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Claude Code" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10"
                                   Text="Easiest: let TraceBrake add the entry for you — it writes a user-scope &quot;foreman&quot; server into ~/.claude.json (a backup of the original is saved first)." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Connect automatically" Click="ConnectClaudeClick" Margin="0,0,8,0"
                                    Background="{StaticResource AccentBrush}" Foreground="#FF0D0F12" FontWeight="Bold" />
                            <Button Content="Copy CLI command" Click="CopyCliClick" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                                   Text="Or paste this into ~/.claude.json (merge into the top-level mcpServers object):" />
                        <TextBox x:Name="ClaudeJsonBox" Style="{StaticResource Mono}" Height="124" />
                        <Button Content="Copy JSON" Click="CopyClaudeJsonClick" HorizontalAlignment="Left" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Codex -->
                <Border CornerRadius="8" Padding="14" Margin="0,0,0,12"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Codex" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10"
                                   Text="Easiest: let TraceBrake add the entry for you. It writes a user-scope &quot;foreman&quot; server into ~/.codex/config.toml and adds a marked TraceBrake section to ~/.codex/AGENTS.md so Codex knows how to receive and answer Ask Harness and audit prompts." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Connect automatically" Click="ConnectCodexClick" Margin="0,0,8,0"
                                    Background="{StaticResource AccentBrush}" Foreground="#FF0D0F12" FontWeight="Bold" />
                            <Button Content="Copy TOML" Click="CopyCodexTomlClick" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                                   Text="Or paste this into ~/.codex/config.toml, then add the TraceBrake MCP Monitor section to ~/.codex/AGENTS.md and restart Codex:" />
                        <TextBox x:Name="CodexTomlBox" Style="{StaticResource Mono}" Height="112" />
                    </StackPanel>
                </Border>

                <!-- Cursor -->
                <Border CornerRadius="8" Padding="14" Margin="0,0,0,12"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Cursor" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10"
                                   Text="Easiest: let TraceBrake add the entry for you — it writes a &quot;foreman&quot; remote server into Cursor's ~/.cursor/mcp.json (a backup of the original is saved first)." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Connect automatically" Click="ConnectCursorClick" Margin="0,0,8,0"
                                    Background="{StaticResource AccentBrush}" Foreground="#FF0D0F12" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                                   Text="Or merge this into ~/.cursor/mcp.json (the mcpServers object), then restart Cursor or refresh the server in Settings → Tools &amp; MCP:" />
                        <TextBox x:Name="CursorJsonBox" Style="{StaticResource Mono}" Height="124" />
                        <Button Content="Copy JSON" Click="CopyCursorJsonClick" HorizontalAlignment="Left" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- OpenCode -->
                <Border CornerRadius="8" Padding="14" Margin="0,0,0,12"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="OpenCode" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10"
                                   Text="Easiest: let TraceBrake add the entry for you — it writes a remote &quot;foreman&quot; server into the mcp object of OpenCode's opencode.json (a backup of the original is saved first)." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Connect automatically" Click="ConnectOpenCodeClick" Margin="0,0,8,0"
                                    Background="{StaticResource AccentBrush}" Foreground="#FF0D0F12" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                                   Text="Or merge this into opencode.json (the top-level mcp object), then restart OpenCode:" />
                        <TextBox x:Name="OpenCodeJsonBox" Style="{StaticResource Mono}" Height="150" />
                        <Button Content="Copy JSON" Click="CopyOpenCodeJsonClick" HorizontalAlignment="Left" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- GitHub Copilot CLI -->
                <Border CornerRadius="8" Padding="14" Margin="0,0,0,12"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="GitHub Copilot CLI" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10"
                                   Text="Easiest: let TraceBrake add the entry for you — it writes an HTTP &quot;foreman&quot; server into ~/.copilot/mcp-config.json (a backup of the original is saved first)." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Connect automatically" Click="ConnectCopilotClick" Margin="0,0,8,0"
                                    Background="{StaticResource AccentBrush}" Foreground="#FF0D0F12" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                                   Text="Or merge this into ~/.copilot/mcp-config.json (the mcpServers object), then restart Copilot CLI or run /mcp:" />
                        <TextBox x:Name="CopilotJsonBox" Style="{StaticResource Mono}" Height="150" />
                        <Button Content="Copy JSON" Click="CopyCopilotJsonClick" HorizontalAlignment="Left" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Gemini CLI -->
                <Border CornerRadius="8" Padding="14" Margin="0,0,0,12"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Gemini CLI" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10"
                                   Text="Easiest: let TraceBrake add the entry for you — it writes a streamable-HTTP &quot;foreman&quot; server into ~/.gemini/settings.json (a backup of the original is saved first). Note Gemini uses httpUrl for streamable HTTP, not url." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Connect automatically" Click="ConnectGeminiClick" Margin="0,0,8,0"
                                    Background="{StaticResource AccentBrush}" Foreground="#FF0D0F12" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                                   Text="Or merge this into ~/.gemini/settings.json (the mcpServers object), then restart Gemini CLI:" />
                        <TextBox x:Name="GeminiJsonBox" Style="{StaticResource Mono}" Height="124" />
                        <Button Content="Copy JSON" Click="CopyGeminiJsonClick" HorizontalAlignment="Left" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- LM Studio (caveat emptor) -->
                <Border CornerRadius="8" Padding="14" Margin="0,0,0,12"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="LM Studio" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10"
                                   Text="Writes a local &quot;foreman&quot; bridge into LM Studio's ~/.lmstudio/mcp.json (a backup is saved first; LM Studio reloads it). This works around an LM Studio bug (#1892) where it drops the Authorization header on REMOTE MCP servers — so instead LM Studio launches a small local mcp-remote bridge (via npx; needs Node) that injects TraceBrake's token itself and forwards to the loopback endpoint. After connecting, click Restart in LM Studio's Integrations panel. Heads-up: the bridge pulls mcp-remote from npm on first run." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Connect automatically" Click="ConnectLmStudioClick" Margin="0,0,8,0"
                                    Background="{StaticResource AccentBrush}" Foreground="#FF0D0F12" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                                   Text="Or merge this into ~/.lmstudio/mcp.json (the mcpServers object):" />
                        <TextBox x:Name="LmStudioJsonBox" Style="{StaticResource Mono}" Height="124" />
                        <Button Content="Copy JSON" Click="CopyLmStudioJsonClick" HorizontalAlignment="Left" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- T3 Code (control plane) -->
                <Border CornerRadius="8" Padding="14" Margin="0,0,0,12"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="T3 Code (control plane)" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10"
                                   Text="T3 Code runs an underlying agent (Claude Code, Codex, or OpenCode). Connect that agent using its card above — T3 Code uses the same MCP server, and TraceBrake monitors T3 Code itself as the control plane. 'Connect automatically' copies the config to paste into whichever agent T3 Code drives." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Copy config" Click="ConnectT3Click" Margin="0,0,8,0"
                                    Background="{StaticResource AccentBrush}" Foreground="#FF0D0F12" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                                   Text="Config for the agent T3 Code runs (merge into its mcpServers object):" />
                        <TextBox x:Name="T3Box" Style="{StaticResource Mono}" Height="124" />
                        <Button Content="Copy JSON" Click="CopyT3Click" HorizontalAlignment="Left" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Any other client -->
                <Border CornerRadius="8" Padding="14"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Any other MCP client" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10"
                                   Text="In your agent's MCP config, add an HTTP (streamable-HTTP) server using this URL and Authorization header:" />
                        <TextBox x:Name="GenericBox" Style="{StaticResource Mono}" Height="150" />
                        <Button Content="Copy" Click="CopyGenericClick" HorizontalAlignment="Left" Margin="0,6,0,0" />
                        <TextBlock x:Name="TokenNote" Style="{StaticResource Muted}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- LiveWeave (on-device page builder, paired like an extension) -->
                <Border CornerRadius="8" Padding="14" Margin="0,12,0,0"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🌐 LiveWeave (on-device page builder)" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,8"
                                   Text="LiveWeave pairs through the browser extension and renders into a local TraceBrake-owned canvas. In the extension options, choose LiveWeave mode and a driver harness before pairing." />
                        <TextBlock x:Name="LiveWeaveStatusText" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                                   Text="Once paired, only the selected driver harness, or the operator token, can drive LiveWeave. Empty driver means operator-only; any is an explicit all-harness mode." />
                        <Button Content="Pair LiveWeave…" Click="PairLiveWeaveClick" HorizontalAlignment="Left"
                                Background="{StaticResource AccentBrush}" Foreground="#FF0D0F12" FontWeight="Bold" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" HorizontalAlignment="Left"
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" FontFamily="Segoe UI, Arial" />
        </Grid>
    </Grid>
</UserControl>
