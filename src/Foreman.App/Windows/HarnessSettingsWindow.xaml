<Window x:Class="Foreman.App.Windows.HarnessSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Harness settings" Width="620" Height="840"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header + badges -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI, Arial" />
            <WrapPanel x:Name="BadgePanel" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Trust level + universal profiles -->
        <Border Grid.Row="1" CornerRadius="8" Padding="14" Margin="0,0,0,12"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Trust" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI, Arial" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,8"
                           Text="Choose this harness's Trust level. It controls behaviour sensitivity, responses and the browser, desktop and ADB capability profile inherited below. Changes apply immediately." />
                <ComboBox x:Name="TrustLevelCombo" MinWidth="260" HorizontalAlignment="Left"
                          SelectionChanged="TrustLevelCombo_SelectionChanged" />
                <TextBlock x:Name="TrustSummary" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI, Arial" />
                <Separator Margin="0,14,0,12" Background="{StaticResource BorderBrush}" />
                <Button Content="Universal Trust Settings…" Click="UniversalTrustSettingsClick"
                        HorizontalAlignment="Left" ToolTip="Edit the observation and control privileges inherited by Trust levels 1–5" />
            </StackPanel>
        </Border>

        <!-- Modalities (the restricted sysprompt) -->
        <Border Grid.Row="2" CornerRadius="8" Padding="14"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Self-service modalities" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI, Arial" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,8"
                           Text="The small, structured operations this harness is told to honour (delivered over MCP). Tiny-model-friendly by design." />
                <StackPanel x:Name="ModalityPanel" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" CornerRadius="8" Padding="14" Margin="0,12,0,0"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Per-harness capability ceiling" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI, Arial" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,8"
                           Text="Optional restrictions on top of the selected universal Trust profile. Use profile inherits it; Always ask requires approval; Never removes access. These settings can only make this harness more restricted." />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Desktop + ADB ceiling" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI, Arial" />
                    <ComboBox x:Name="ComputerUseCombo" Grid.Row="0" Grid.Column="1" MinWidth="180" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Browser ceiling" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI, Arial" />
                    <ComboBox x:Name="BrowserUseCombo" Grid.Row="1" Grid.Column="1" MinWidth="180" />
                </Grid>

                <Separator Margin="0,16,0,14" Background="{StaticResource BorderBrush}" />

                <StackPanel x:Name="CuDriverPanel">
                    <TextBlock Text="TraceBrake shared computer-use drivers" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI, Arial" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,8"
                               Text="Who may submit TraceBrake-mediated browser and Android/ADB (cu_*) actions through the unified plugin. This is global routing, separate from the harness policies above. Browser actions use Browser use policy; Android uses Computer use policy. Actions remain audited, approval-gated when risky, and panic-haltable." />
                    <ComboBox x:Name="ForemanDriverCombo" MinWidth="260">
                        <ComboBoxItem Tag="unchanged" Content="Leave TraceBrake's driver set unchanged" />
                        <ComboBoxItem Tag="include" Content="Add this harness to TraceBrake's shared driver set" />
                        <ComboBoxItem Tag="remove" Content="Remove this harness from TraceBrake's shared driver set" />
                        <ComboBoxItem Tag="only" Content="Make this harness TraceBrake's only driver" />
                        <ComboBoxItem Tag="any" Content="Allow any harness to drive browser and Android use" />
                        <ComboBoxItem Tag="operator" Content="Operator only — no harness driver" />
                    </ComboBox>
                    <TextBlock x:Name="CuDriverNote" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                    <TextBlock x:Name="CuAttentionNote" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" HorizontalAlignment="Left"
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" FontFamily="Segoe UI, Arial" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="CancelClick" Margin="0,0,8,0" />
                <Button Content="Save" Click="SaveClick" Padding="18,6"
                        Background="{StaticResource AccentBrush}" Foreground="#FF0D0F12" FontWeight="Bold" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
